<Window x:Class="Snug.Windows.HomeBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Background="#F2F2F7"
        Foreground="#73737C" FontFamily="Segoe UI">
    <!-- Upstream PhoneScreenWindows.HomeBarView: a 28-point bottom panel
         with a compact upward chevron. Only visible while an app is placed. -->
    <Grid Background="#F2F2F7"
          PreviewMouseLeftButtonDown="OnSwipeDown"
          PreviewMouseMove="OnSwipeMove"
          PreviewMouseLeftButtonUp="OnSwipeUp"
          PreviewMouseWheel="OnSwipeWheel"
          PreviewTouchDown="OnTouchDown"
          PreviewTouchMove="OnTouchMove"
          PreviewTouchUp="OnTouchUp">
        <Button x:Name="ReturnButton" Click="ShowList_Click"
                ToolTip="返回 App 资源库"
                AutomationProperties.Name="返回 App 资源库"
                Background="Transparent" BorderThickness="0"
                Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Path Data="M 10,23 L 22,11 L 34,23"
                  Width="44" Height="30" Stretch="Uniform"
                  Stroke="#86868F" StrokeThickness="4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="BrowserZoomButton" Visibility="Collapsed"
                HorizontalAlignment="Right" Width="86" Margin="0,0,5,0"
                Background="Transparent" BorderThickness="0"
                Click="ToggleBrowserZoom_Click" ToolTip="网页缩放"
                AutomationProperties.Name="调整浏览器网页缩放">
            <TextBlock x:Name="BrowserZoomButtonText" Text="缩放" Foreground="#494955"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="13"/>
        </Button>
        <Popup x:Name="BrowserZoomPopup"
               PlacementTarget="{Binding ElementName=BrowserZoomButton}"
               Placement="Top" VerticalOffset="-8" AllowsTransparency="True"
               StaysOpen="False" Focusable="False">
            <Border Background="#FCFCFE" BorderBrush="#C9CAD5" BorderThickness="1"
                    CornerRadius="17" Padding="16,12" Width="288">
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="网页缩放" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#33343E"/>
                        <TextBlock x:Name="BrowserZoomPercentText" DockPanel.Dock="Right"
                                   Text="100%" HorizontalAlignment="Right"
                                   Foreground="#33343E" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Slider x:Name="BrowserZoomSlider" Minimum="0" Maximum="10"
                            TickFrequency="1" IsSnapToTickEnabled="True" Value="5"
                            AutoToolTipPlacement="None" Height="30"
                            PreviewMouseLeftButtonUp="BrowserZoomSlider_MouseUp"
                            PreviewTouchUp="BrowserZoomSlider_TouchUp"
                            ValueChanged="BrowserZoomSlider_ValueChanged"
                            AutomationProperties.Name="浏览器网页缩放比例"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button Content="−" Click="BrowserZoomMinus_Click"
                                DockPanel.Dock="Left" Width="45" Height="28"
                                AutomationProperties.Name="缩小网页"/>
                        <Button Content="重置" Click="BrowserZoomReset_Click"
                                DockPanel.Dock="Right" Width="64" Height="28"
                                AutomationProperties.Name="恢复网页到100%"/>
                        <Button Content="+" Click="BrowserZoomPlus_Click"
                                DockPanel.Dock="Right" Width="45" Height="28" Margin="0,0,7,0"
                                AutomationProperties.Name="放大网页"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
        <Button x:Name="CameraButton" Visibility="Collapsed" HorizontalAlignment="Left"
                Width="64" Background="#F2F2F7" BorderThickness="0" Padding="0"
                ToolTip="截图" AutomationProperties.Name="截图"
                Click="Capture_Click">
            <Viewbox x:Name="CameraGlyph" Width="20" Height="20" Stretch="Uniform">
                <Path Data="M 2,8 L 2,2 L 8,2 M 16,2 L 22,2 L 22,8 M 22,16 L 22,22 L 16,22 M 8,22 L 2,22 L 2,16 M 12,7 A 5,5 0 1 1 11.99,7"
                      Stroke="#86868F" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
        </Button>
    </Grid>
</Window>
