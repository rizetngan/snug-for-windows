<Window x:Class="Snug.Windows.PhoneSurfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snug.Windows"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Background="#F2F2F7"
        Foreground="#17171A" FontFamily="Segoe UI">
    <Window.Resources>
        <local:PhoneConfirmationVisibilityConverter x:Key="ConfirmationVisibility"/>
        <local:PhonePlacedVisibilityConverter x:Key="PlacedWindowVisibility"/>
        <SolidColorBrush x:Key="PhoneBackground" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="PhoneCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PhoneFill" Color="#E4E4E9"/>
        <SolidColorBrush x:Key="PhoneInk" Color="#17171A"/>
        <SolidColorBrush x:Key="PhoneSecondary" Color="#73737C"/>
        <SolidColorBrush x:Key="PhoneTint" Color="#007AFF"/>
        <SolidColorBrush x:Key="PhoneDivider" Color="#E6E6E9"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PhoneInk}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PhoneInk}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.64"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Upstream PhoneWidgets.RoundButton: 56-point circular hit target. -->
        <Style x:Key="RoundAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="{StaticResource PhoneBackground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Upstream PhoneWidgets.PillButton: inline cancel/destructive affordances. -->
        <Style x:Key="InlineCancel" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource PhoneInk}"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{StaticResource PhoneBackground}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineDestructive" TargetType="Button" BasedOn="{StaticResource InlineCancel}">
            <Setter Property="Background" Value="#E33B43"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SearchField" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PhoneFill}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Height" Value="54"/>
        </Style>
        <!-- Direct Windows rendering of upstream PhoneAppCard + PhoneWidgets: inline
             one-at-a-time confirmation, round icons, 56pt touch targets. -->
        <DataTemplate x:Key="RunningAppCard">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource PhoneInk}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
            </DataTemplate.Resources>
            <Border Background="{StaticResource PhoneCard}" CornerRadius="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="16,12,12,12" Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Tag="{Binding App}" Click="OpenApp_Click"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <Border CornerRadius="12" Background="{StaticResource PhoneFill}"/>
                                    <TextBlock Text="{Binding App.Name, Converter={StaticResource FirstLetterConverter}}"
                                               FontWeight="SemiBold" FontSize="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding App, Converter={StaticResource AppIconConverter}}"
                                           Stretch="Uniform" Width="48" Height="48"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,8,0">
                                    <TextBlock Text="{Binding App.Name}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PhoneInk}"/>
                                    <TextBlock Text="{Binding WindowSummary}" Foreground="{StaticResource PhoneSecondary}"
                                               FontSize="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Grid Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource ConfirmationVisibility}" ConverterParameter="normal">
                                        <Binding/>
                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="ActiveConfirmation"/>
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <Button Style="{StaticResource RoundAction}" Tag="{Binding App}"
                                        Click="NewWindow_Click" ToolTip="新建窗口"
                                        AutomationProperties.Name="新建窗口" Margin="0,0,8,0">
                                    <Canvas Width="28" Height="28">
                                        <Rectangle Canvas.Left="5" Canvas.Top="3" Width="20" Height="17"
                                                   RadiusX="3" RadiusY="3" Stroke="{StaticResource PhoneInk}" StrokeThickness="2.3"/>
                                        <Line X1="5" Y1="8" X2="25" Y2="8" Stroke="{StaticResource PhoneInk}" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="0" Canvas.Top="14" Width="14" Height="14"
                                                 Fill="{StaticResource PhoneBackground}"/>
                                        <Path Data="M 7,16 L 7,26 M 2,21 L 12,21"
                                              Stroke="{StaticResource PhoneInk}" StrokeThickness="2.5"
                                              StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Button>
                                <Button Style="{StaticResource RoundAction}" Tag="{Binding}"
                                        Click="QuitApp_Click" ToolTip="退出 App"
                                        AutomationProperties.Name="退出 App">
                                    <Canvas Width="26" Height="26">
                                        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="22" Height="22"
                                                   RadiusX="5" RadiusY="5" Stroke="{StaticResource PhoneInk}"
                                                   StrokeThickness="2.3"/>
                                        <Path Data="M 9,9 L 17,17 M 17,9 L 9,17"
                                              Stroke="{StaticResource PhoneInk}" StrokeThickness="2.5"
                                              StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource ConfirmationVisibility}">
                                        <Binding/>
                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="ActiveConfirmation"/>
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <Button Click="CancelConfirm_Click" Style="{StaticResource InlineCancel}" Margin="0,0,8,0"
                                        AutomationProperties.Name="取消退出"><TextBlock Text="取消" Foreground="#17171A" FontWeight="Medium"/></Button>
                                <Button Click="ConfirmQuitInline_Click" Tag="{Binding}" Content="退出"
                                        Style="{StaticResource InlineDestructive}" AutomationProperties.Name="确认退出"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Windows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Height="1" Background="{StaticResource PhoneDivider}" Margin="80,0,0,0"/>
                                    <Grid Margin="16,0,12,0" Height="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Tag="{Binding}" Click="OpenWindow_Click"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Canvas Grid.Column="0" Width="28" Height="26" HorizontalAlignment="Center">
                                                    <Rectangle Canvas.Left="2" Canvas.Top="5" Width="24" Height="18"
                                                               RadiusX="3" RadiusY="3"
                                                               Stroke="{StaticResource PhoneSecondary}" StrokeThickness="2"/>
                                                    <Path Data="M 2,11 L 26,11" Stroke="{StaticResource PhoneSecondary}" StrokeThickness="1.5"/>
                                                    <Ellipse Canvas.Left="5" Canvas.Top="7" Width="2.5" Height="2.5" Fill="{StaticResource PhoneSecondary}"/>
                                                    <Ellipse Canvas.Left="10" Canvas.Top="7" Width="2.5" Height="2.5" Fill="{StaticResource PhoneSecondary}"/>
                                                </Canvas>
                                                <Grid Grid.Column="1" Margin="16,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource PhoneInk}"
                                                               FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,3"
                                                            VerticalAlignment="Center" Background="#E1EFFD" CornerRadius="12">
                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource PlacedWindowVisibility}">
                                                                <Binding/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="Controller.PlacedWindowKey"/>
                                                            </MultiBinding>
                                                        </Border.Visibility>
                                                        <TextBlock Text="在手机屏上" FontSize="15" FontWeight="Medium"
                                                                   Foreground="{StaticResource PhoneTint}"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <Grid Grid.Column="1">
                                            <Button Style="{StaticResource RoundAction}" Tag="{Binding}"
                                                    Click="CloseWindow_Click" ToolTip="关闭窗口"
                                                    AutomationProperties.Name="关闭窗口">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource ConfirmationVisibility}" ConverterParameter="normal">
                                                        <Binding/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="ActiveConfirmation"/>
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <Canvas Width="28" Height="28">
                                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="24" Height="24"
                                                             Fill="#B8B8BE"/>
                                                    <Path Data="M 10,10 L 18,18 M 18,10 L 10,18"
                                                          Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
                                                </Canvas>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <StackPanel.Visibility>
                                                    <MultiBinding Converter="{StaticResource ConfirmationVisibility}">
                                                        <Binding/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="ActiveConfirmation"/>
                                                    </MultiBinding>
                                                </StackPanel.Visibility>
                                                <Button Click="CancelConfirm_Click" Style="{StaticResource InlineCancel}"
                                                        Margin="0,0,8,0" AutomationProperties.Name="取消关闭"><TextBlock Text="取消" Foreground="#17171A" FontWeight="Medium"/></Button>
                                                <Button Click="ConfirmCloseInline_Click" Tag="{Binding}" Content="关闭"
                                                        Style="{StaticResource InlineDestructive}"
                                                        AutomationProperties.Name="确认关闭"/>
                                            </StackPanel>
                                        </Grid>
                                     </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="80,0,12,12">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource PlacedWindowVisibility}">
                                                <Binding/>
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="Controller.PlacedWindowKey"/>
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <Button Style="{StaticResource RoundAction}" Click="ZoomOutPlaced_Click"
                                                ToolTip="缩小字号" AutomationProperties.Name="缩小字号"
                                                Margin="0,0,8,0">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource PlacedWindowVisibility}" ConverterParameter="zoom">
                                                    <Binding/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="Controller.PlacedWindowKey"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <TextBlock Text="A−" Foreground="{StaticResource PhoneInk}" FontSize="20"/>
                                        </Button>
                                        <Button Style="{StaticResource RoundAction}" Click="ZoomInPlaced_Click"
                                                ToolTip="放大字号" AutomationProperties.Name="放大字号"
                                                Margin="0,0,12,0">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource PlacedWindowVisibility}" ConverterParameter="zoom">
                                                    <Binding/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:PhoneSurfaceWindow}}" Path="Controller.PlacedWindowKey"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <TextBlock Text="A+" Foreground="{StaticResource PhoneInk}" FontSize="20"/>
                                        </Button>
                                        <Button Style="{StaticResource InlineCancel}" Click="RestorePlaced_Click"
                                                ToolTip="还原窗口" AutomationProperties.Name="还原窗口"
                                                Padding="20,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↶" FontSize="24" Margin="0,0,8,0" Foreground="{StaticResource PhoneInk}"/>
                                                <TextBlock Text="还原" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource PhoneInk}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InstalledIcon">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource PhoneInk}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                </Style>
            </DataTemplate.Resources>            <Button Tag="{Binding App}" Click="OpenApp_Click"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                    AutomationProperties.Name="{Binding App.Name}">
                <StackPanel Width="116" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <Border Background="{StaticResource PhoneCard}" CornerRadius="17"/>
                        <TextBlock Foreground="{StaticResource PhoneInk}" Text="{Binding App.Name, Converter={StaticResource FirstLetterConverter}}"
                                   FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <Image Source="{Binding App, Converter={StaticResource AppIconConverter}}"
                               Stretch="Uniform" Width="72" Height="72"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource PhoneInk}" Text="{Binding App.Name}" FontSize="15" TextAlignment="Center"
                               Margin="0,8,0,0" MaxWidth="116" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding App.Name}"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SearchAppRow">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource PhoneInk}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                </Style>
            </DataTemplate.Resources>            <Button Tag="{Binding}" Click="SearchApp_Click" HorizontalContentAlignment="Stretch" MinHeight="80">
                <Grid Margin="16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                           Width="48" Height="48" Stretch="Uniform"/>
                    <TextBlock Foreground="{StaticResource PhoneInk}" Grid.Column="1" Text="{Binding Name}" FontSize="19"
                               FontWeight="Medium" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SearchWindowRow">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource PhoneInk}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                </Style>
            </DataTemplate.Resources>            <Button Tag="{Binding}" Click="SearchWindow_Click"
                    HorizontalContentAlignment="Stretch" MinHeight="80">
                <Grid Margin="16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="▣" FontSize="24" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{StaticResource PhoneSecondary}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Foreground="{StaticResource PhoneInk}" Text="{Binding Title}" FontSize="19"/>
                        <TextBlock Text="{Binding AppName}" FontSize="15"
                                   Foreground="{StaticResource PhoneSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="PhoneCanvas" Width="540" Height="950" Background="{StaticResource PhoneBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <!-- Dedicated native UU phone operation-tray inset. Scrollable
                     content ends above it; the Window still covers the full
                     VDD, shielding the Windows secondary taskbar. -->
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>

            <!-- Back row is always reserved so the title never jumps. -->
            <Grid Grid.Row="0" Margin="20,12,20,0">
                <Button x:Name="ReturnButton" HorizontalAlignment="Left" Click="ReturnToPlaced_Click"
                        Visibility="Collapsed" Background="#E1EDFD" Padding="16,10"
                        AutomationProperties.Name="返回当前 App">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="‹" Foreground="{StaticResource PhoneTint}" FontSize="29" Margin="0,-5,8,-5"/>
                        <TextBlock x:Name="ReturnAppName" Foreground="{StaticResource PhoneTint}"
                                   FontSize="18" VerticalAlignment="Center" MaxWidth="180"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PhoneModelButton" HorizontalAlignment="Right" Width="56" Height="56"
                        Click="PhoneModel_Click" ToolTip="手机型号" AutomationProperties.Name="手机型号">
                    <Grid Width="25" Height="33">
                        <Border BorderBrush="{StaticResource PhoneTint}" BorderThickness="2.6" CornerRadius="5"/>
                        <Ellipse Width="4" Height="4" Fill="{StaticResource PhoneTint}"
                                 VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton" HorizontalAlignment="Center" Click="Close_Click"
                        Visibility="Collapsed"  Foreground="{StaticResource PhoneInk}" Padding="14,9" FontSize="14"><TextBlock Text="关闭预览" Foreground="{StaticResource PhoneInk}" /></Button>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="HomeScroll" AutomationProperties.Name="App 列表" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" ScrollChanged="HomeScroll_ScrollChanged">
                    <StackPanel>
                        <StackPanel x:Name="HomeHeader" Margin="20,4,20,0">
                            <TextBlock Foreground="{StaticResource PhoneInk}" Text="App" FontWeight="Bold" FontSize="40" Margin="0,0,0,14"/>
                            <Button Click="OpenSearch_Click" HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="搜索 App">
                                <Border Style="{StaticResource SearchField}" Padding="13,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⌕" FontSize="27" Foreground="{StaticResource PhoneSecondary}"
                                                   Margin="0,-2,8,0"/>
                                        <TextBlock Text="搜索 App" FontSize="18" Foreground="{StaticResource PhoneSecondary}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Border x:Name="NoticeBanner" Visibility="Collapsed"
                                    Background="#FFF4DD" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="NoticeText" FontSize="16" Foreground="#805000"
                                               TextWrapping="Wrap" TextTrimming="None"/>
                                    <StackPanel x:Name="ForceQuitActions" Visibility="Collapsed"
                                                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Style="{StaticResource InlineCancel}" Margin="0,0,12,0"
                                                Click="DismissQuitStalled_Click" AutomationProperties.Name="取消强制退出">
                                            <TextBlock Text="取消" Foreground="#17171A" FontWeight="Medium"/>
                                        </Button>
                                        <Button x:Name="ForceQuitButton" Style="{StaticResource InlineDestructive}"
                                                Content="强制退出" Click="ForceQuit_Click"
                                                AutomationProperties.Name="强制退出 App"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid x:Name="InlineTabs" Margin="20,16,20,12" Height="50">
                            <Border Background="{StaticResource PhoneFill}" CornerRadius="12"/>
                            <Grid Margin="3">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="RunningTab" Grid.Column="0" Click="RunningTab_Click"
                                        Background="{StaticResource PhoneCard}"  Foreground="{StaticResource PhoneInk}"
                                        FontSize="17" FontWeight="SemiBold"><TextBlock Text="运行中" Foreground="{StaticResource PhoneInk}" /></Button>
                                <Button x:Name="AllTab" Grid.Column="1" Click="AllTab_Click"
                                         Foreground="{StaticResource PhoneInk}" FontSize="17" FontWeight="Medium"><TextBlock Text="全部" Foreground="{StaticResource PhoneInk}" /></Button>
                            </Grid>
                        </Grid>

                        <StackPanel x:Name="RunningContent" Margin="20,0,20,24">
                            <StackPanel x:Name="CurrentSection" Visibility="Collapsed">
                                <TextBlock Text="当前 App" FontSize="15" Foreground="{StaticResource PhoneSecondary}"
                                           Margin="4,8,0,8"/>
                                <ItemsControl ItemsSource="{Binding CurrentRunningApps}"
                                              ItemTemplate="{StaticResource RunningAppCard}"/>
                                <TextBlock Text="其他 App" FontSize="15" Foreground="{StaticResource PhoneSecondary}"
                                           Margin="4,12,0,8"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding VisibleRunningApps}"
                                          ItemTemplate="{StaticResource RunningAppCard}"/>
                            <TextBlock x:Name="RunningEmpty" Text="没有正在运行的 App" HorizontalAlignment="Center"
                                       Foreground="{StaticResource PhoneSecondary}" FontSize="18"
                                       Margin="0,50,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="RunningLoading" Text="正在读取" HorizontalAlignment="Center"
                                       Foreground="{StaticResource PhoneSecondary}" FontSize="18"
                                       Margin="0,50,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel x:Name="AllContent" Visibility="Collapsed" Margin="20,0,20,24">
                            <ItemsControl ItemsSource="{Binding VisibleAllApps}"
                                          ItemTemplate="{StaticResource InstalledIcon}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="AllEmpty" Text="没有可用的 App" FontSize="18"
                                       Foreground="{StaticResource PhoneSecondary}" TextAlignment="Center"
                                       Margin="0,50,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="AllLoading" Text="正在读取" FontSize="18"
                                       Foreground="{StaticResource PhoneSecondary}" TextAlignment="Center"
                                       Margin="0,50,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="PinnedTabs" Visibility="Collapsed" Margin="20,0,20,0"
                      Height="56" VerticalAlignment="Top" Panel.ZIndex="5">
                    <Border Background="{StaticResource PhoneBackground}"/>
                    <Border Background="{StaticResource PhoneFill}" CornerRadius="12" Margin="0,3,0,3"/>
                    <Grid Margin="3,6,3,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="PinnedRunningTab" Grid.Column="0" Click="RunningTab_Click"
                                Background="{StaticResource PhoneCard}"  Foreground="{StaticResource PhoneInk}"
                                FontSize="17" FontWeight="SemiBold"><TextBlock Text="运行中" Foreground="{StaticResource PhoneInk}" /></Button>
                        <Button x:Name="PinnedAllTab" Grid.Column="1" Click="AllTab_Click"
                                 Foreground="{StaticResource PhoneInk}" FontSize="17"><TextBlock Text="全部" Foreground="{StaticResource PhoneInk}" /></Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Search owns focus only while open. -->
            <Grid x:Name="SearchOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                  Panel.ZIndex="20" Background="{StaticResource PhoneBackground}">
                <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="20,12,20,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SearchField}" Padding="13,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="27" Foreground="{StaticResource PhoneSecondary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchQueryBox" Grid.Column="1" TextChanged="SearchQuery_TextChanged"
                                     BorderThickness="0" Background="Transparent" FontSize="18"
                                     Foreground="{StaticResource PhoneInk}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="搜索 App 和窗口"/>
                            <Button Grid.Column="2" Click="ClearSearch_Click"  FontSize="24"
                                    Foreground="{StaticResource PhoneSecondary}" ToolTip="清除搜索"><TextBlock Text="×" Foreground="{StaticResource PhoneSecondary}" /></Button>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1"  Click="CloseSearch_Click"
                            Foreground="{StaticResource PhoneTint}" FontSize="18"
                            HorizontalContentAlignment="Right" AutomationProperties.Name="取消搜索"><TextBlock Text="取消" Foreground="{StaticResource PhoneTint}" /></Button>
                </Grid>
                <ScrollViewer x:Name="SearchScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="20,8,20,24">
                        <StackPanel x:Name="SearchResults" Visibility="Collapsed">
                            <StackPanel x:Name="SearchAppsSection">
                                <TextBlock Text="App" Foreground="{StaticResource PhoneSecondary}"
                                           Margin="4,4,0,8" FontSize="15"/>
                                <Border Background="{StaticResource PhoneCard}" CornerRadius="12">
                                    <ItemsControl ItemsSource="{Binding SearchApps}"
                                                  ItemTemplate="{StaticResource SearchAppRow}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="SearchWindowsSection" Margin="0,20,0,0">
                                <TextBlock Text="窗口" Foreground="{StaticResource PhoneSecondary}"
                                           Margin="4,4,0,8" FontSize="15"/>
                                <Border Background="{StaticResource PhoneCard}" CornerRadius="12">
                                    <ItemsControl ItemsSource="{Binding SearchWindows}"
                                                  ItemTemplate="{StaticResource SearchWindowRow}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SearchEmpty" Text="没有找到匹配的 App 或窗口"
                                       Foreground="{StaticResource PhoneSecondary}" FontSize="18"
                                       TextAlignment="Center" Margin="0,55,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ItemsControl x:Name="SearchBrowse" ItemsSource="{Binding VisibleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Letter}" FontSize="15" Margin="4,0,0,7"
                                                   Foreground="{StaticResource PhoneSecondary}"/>
                                        <Border Background="{StaticResource PhoneCard}" CornerRadius="12">
                                            <ItemsControl ItemsSource="{Binding Apps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Tag="{Binding App}" Click="OpenApp_Click"
                                                                MinHeight="64" HorizontalContentAlignment="Stretch">
                                                            <StackPanel Orientation="Horizontal" Margin="16,8">
                                                                <Image Source="{Binding App, Converter={StaticResource AppIconConverter}}"
                                                                       Width="42" Height="42"/>
                                                                <TextBlock Foreground="{StaticResource PhoneInk}" Text="{Binding App.Name}" FontSize="18"
                                                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="PhoneModelOverlay" Grid.RowSpan="2" Panel.ZIndex="30"
                    Visibility="Collapsed" Background="{StaticResource PhoneBackground}">
                <local:PhoneModelPicker x:Name="PhoneModelPicker"/>
            </Border>

            <Grid x:Name="ConfirmationOverlay" Grid.RowSpan="2" Panel.ZIndex="40" Visibility="Collapsed"
                  Background="#99000000">
                <Border Background="{StaticResource PhoneCard}" CornerRadius="20" Padding="22"
                        Width="430" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource PhoneInk}" x:Name="ConfirmTitle" FontSize="22" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"/>
                        <TextBlock x:Name="ConfirmDescription" Text="如果有未保存的内容，应用可能会要求先保存。"
                                   FontSize="15" Margin="0,12,0,24" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="None"
                                   Foreground="{StaticResource PhoneSecondary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button  Foreground="{StaticResource PhoneInk}" Click="CancelConfirm_Click" Background="{StaticResource PhoneFill}"
                                    Padding="0,14" FontSize="18" Margin="0,0,6,0"><TextBlock Text="取消" Foreground="{StaticResource PhoneInk}" /></Button>
                            <Button x:Name="ConfirmActionButton" Grid.Column="1"
                                    Click="ConfirmAction_Click"
                                    Background="#F43F48" Foreground="White"
                                    Padding="0,14" FontSize="18" Margin="6,0,0,0"><TextBlock Text="确认" Foreground="White" /></Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="BusyOverlay" Grid.RowSpan="2" Panel.ZIndex="50"
                  Visibility="Collapsed" Background="{StaticResource PhoneBackground}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Foreground="{StaticResource PhoneInk}" x:Name="BusyTitle" Text="正在打开" FontSize="24"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="50,22,50,0" Foreground="{StaticResource PhoneTint}"/>
                    <TextBlock x:Name="BusySubtitle" FontSize="16" Margin="0,16,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource PhoneSecondary}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
