<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseAppHost Condition="'$(SnugUseLegacyWindowsCETWorkaround)' == 'true'">false</UseAppHost>
    <UseAppHost Condition="'$(SnugUseLegacyWindowsCETWorkaround)' != 'true'">true</UseAppHost>
    <CETCompat>true</CETCompat>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Snug.Windows</AssemblyName>
    <RootNamespace>Snug.Windows</RootNamespace>
    <Version>0.2.53</Version>
    <Product>Snug for Windows</Product>
    <Description>Snug — Windows platform support for the original mobile remote workspace.</Description>
    <Copyright>Copyright (c) 2026 AoyamaShou; Copyright (c) 2026 zephyr4123</Copyright>
    <RepositoryUrl>https://github.com/rizetngan/snug-for-windows</RepositoryUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Snug.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SnugUpstreamVersion" Value="2.5.0" />
    <ProjectReference Include="..\Snug.Windows.Core\Snug.Windows.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Content Include="Snug.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\browser-extension\manifest.json" Link="BrowserZoomExtension\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\browser-extension\background.js" Link="BrowserZoomExtension\background.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\browser-extension\README.md" Link="BrowserZoomExtension\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\installer\payload\Driver\Install-SnugDriver.ps1" Link="Driver\Install-SnugDriver.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\installer\payload\Driver\snug_vdd_settings.xml" Link="Driver\snug_vdd_settings.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\installer\payload\Driver\snug_user_edid.bin" Link="Driver\snug_user_edid.bin" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\installer\payload\Driver\VDD\VirtualDisplayDriver-x86.Driver.Only.zip" Link="Driver\VDD\VirtualDisplayDriver-x86.Driver.Only.zip" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\installer\payload\Driver\Tools\nefcon_v1.21.1.zip" Link="Driver\Tools\nefcon_v1.21.1.zip" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\installer\THIRD_PARTY_NOTICES.md" Link="Driver\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\..\Assets\phone-models.json" Link="Assets\phone-models.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>