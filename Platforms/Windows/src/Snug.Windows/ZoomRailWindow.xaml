<Window x:Class="Snug.Windows.ZoomRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" AllowsTransparency="True"
        Background="Transparent" Foreground="#F7F8FA" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewMouseLeftButtonDown="WindowMouseDown"
        PreviewMouseLeftButtonUp="WindowMouseUp"
        PreviewMouseMove="WindowMouseMove"
        PreviewTouchDown="WindowTouchDown"
        PreviewTouchUp="WindowTouchUp"
        PreviewTouchMove="WindowTouchMove">
    <Grid>
        <Border x:Name="CompactBody" Background="#232730" CornerRadius="15">
            <Button x:Name="ExpandButton" Click="Expand_Click" Padding="2,8"
                    BorderThickness="0" Background="Transparent"
                    AutomationProperties.Name="展开缩放控件" ToolTip="缩放">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⇅" FontSize="25" FontWeight="Medium"
                               Foreground="#E7E9F2" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CompactValue" Text="缩放" FontSize="11"
                               FontWeight="SemiBold" Foreground="#F7F8FA"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>

        <Border x:Name="ExpandedBody" Visibility="Collapsed"
                Background="#232730" CornerRadius="19" Padding="7,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="CollapseButton" Grid.Row="0" Click="Collapse_Click"
                        Height="40" FontSize="16" FontWeight="SemiBold" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#F7F8FA"
                        AutomationProperties.Name="收起缩放控件">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="LargeValue" Text="100%"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" ‹" FontSize="21"
                                   VerticalAlignment="Center" Foreground="#AEB6C9"/>
                    </StackPanel>
                </Button>

                <Grid x:Name="TrackHitArea" Grid.Row="1" Background="Transparent"
                      Margin="0,5" SizeChanged="TrackHitArea_SizeChanged"
                      AutomationProperties.Name="上下滑动调整缩放倍率">
                    <Canvas x:Name="TrackCanvas" IsHitTestVisible="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border x:Name="TrackBase" Width="8"
                                Background="#3A4557" CornerRadius="4"/>
                        <Border x:Name="TrackFill" Width="8"
                                Background="#8796AD" CornerRadius="4"/>
                        <Border x:Name="TrackThumb" Width="38" Height="28"
                                Background="#F1F4FA" BorderBrush="#FFFFFF"
                                BorderThickness="1" CornerRadius="9">
                            <Ellipse Width="5" Height="5" Fill="#30394A"/>
                        </Border>
                    </Canvas>
                </Grid>

                <Button x:Name="ResetButton" Grid.Row="2" Click="Reset_Click"
                        Height="38" Margin="0,5,0,0" Padding="0"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="#B9C4D6" BorderThickness="0"
                        Background="Transparent"
                        AutomationProperties.Name="重置缩放倍率">
                    <TextBlock x:Name="ResetLabel" Text="100%"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
