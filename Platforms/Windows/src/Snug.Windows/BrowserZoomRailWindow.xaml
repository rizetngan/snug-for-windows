<Window x:Class="Snug.Windows.BrowserZoomRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Background="#232730"
        Foreground="#F7F8FA" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewMouseLeftButtonDown="WindowMouseDown"
        PreviewMouseLeftButtonUp="WindowMouseUp"
        PreviewTouchDown="WindowTouchDown" PreviewTouchUp="WindowTouchUp">
    <Grid>
        <Border x:Name="CompactBody" Background="#232730" CornerRadius="15">
            <Button x:Name="ExpandButton" Click="Expand_Click" Padding="3,6"
                    BorderThickness="0" Background="Transparent"
                    AutomationProperties.Name="展开浏览器缩放控件" ToolTip="网页缩放">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⇅" FontSize="24" FontWeight="Medium"
                               Foreground="#E7E9F2" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CompactPercent" Text="缩放" FontSize="15"
                               FontWeight="SemiBold" Foreground="#F7F8FA"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
        <Border x:Name="ExpandedBody" Visibility="Collapsed" Background="#232730"
                CornerRadius="19" Padding="6,9">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="CollapseButton" Click="Collapse_Click" Height="42"
                        FontSize="19" FontWeight="SemiBold" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#F7F8FA" AutomationProperties.Name="收起网页缩放控件">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="LargePercent" Text="100%" VerticalAlignment="Center"/>
                        <TextBlock Text=" ‹" FontSize="21" VerticalAlignment="Center" Foreground="#AEB6C9"/>
                    </StackPanel>
                </Button>
                <Button Content="+" Click="Plus_Click" Height="52" FontSize="30"
                        FontWeight="Medium" Foreground="#FFFFFF" Padding="0"
                        Background="#343B49" BorderThickness="0"
                        AutomationProperties.Name="放大网页"/>
                <Slider x:Name="ZoomSlider"
                        Orientation="Vertical" Minimum="0" Maximum="10"
                        Value="5" Height="206" Width="58" Margin="0,9"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        AutoToolTipPlacement="None"
                        ValueChanged="ZoomSlider_ValueChanged"
                        AutomationProperties.Name="上下滑动调整浏览器缩放">
                    <Slider.Resources>
                        <Style TargetType="Thumb">
                            <Setter Property="Width" Value="27"/>
                            <Setter Property="Height" Value="27"/>
                        </Style>
                    </Slider.Resources>
                </Slider>
                <Button Content="−" Click="Minus_Click" Height="52" FontSize="30"
                        FontWeight="Medium" Foreground="#FFFFFF" Padding="0"
                        Background="#343B49" BorderThickness="0"
                        AutomationProperties.Name="缩小网页"/>
                <Button Content="100%" Click="Reset_Click" Height="42" Margin="0,7,0,0"
                        FontSize="16" FontWeight="SemiBold" Foreground="#ABB7CA"
                        BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="重置网页缩放到百分之百"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
